[Unit]
Description=AzurPilot remote registration and pairing
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=azurpilot-remote
WorkingDirectory=/var/lib/azurpilot-remote
ExecStart=/opt/azurpilot-remote/remote-access
EnvironmentFile=/opt/azurpilot-remote/service.env
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
